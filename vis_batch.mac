# vis_dawn_fixed.mac - Alternativa com DAWNFILE

/run/initialize

# Configurar visualização com DAWNFILE
/vis/open DAWNFILE
/vis/drawVolume

# Adicionar eixos de referência
/vis/scene/add/axes 0 0 0 1 km

# Configurar visualização
/vis/viewer/set/viewpointThetaPhi 45 45
/vis/viewer/zoom 0.3

# Gerar arquivo .prim (pode ser convertido depois)
/vis/viewer/flush