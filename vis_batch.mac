# vis_batch_corrected.mac - Macro corrigido para visualização em modo batch

# Primeiro, inicialize a simulação
/run/initialize

# Configurar o sistema de visualização
/vis/open OGLIQt
/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi 45 45
/vis/viewer/zoom 5.0
/vis/viewer/set/style surface
/vis/viewer/set/hiddenEdge 1

# Definir cores e visibilidade
/vis/geometry/set/colour World 0 0.5 0.5 0.5 0.3
/vis/geometry/set/visibility World 0 1

# Adicionar eixos de referência (em km)
/vis/scene/add/axes 0 0 0 1 km

# Definir o tamanho da cena explicitamente (para sua caixa de 10km)
/vis/scene/add/extent -5 -5 -5 km 5 5 5 km

# Configurar trajetórias e acumulação de eventos
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate

# Atualizar visualização
/vis/viewer/refresh

# Configurar para exportar imagens
/vis/viewer/set/autoRefresh false

# Primeira visualização - vista oblíqua
/vis/viewer/set/viewpointThetaPhi 30 30
/vis/ogl/set/printFilename view_30_30
/vis/ogl/printEPS

# Segunda visualização - vista diferente
/vis/viewer/set/viewpointThetaPhi 60 30
/vis/ogl/set/printFilename view_60_30
/vis/ogl/printEPS

# Vista de topo
/vis/viewer/set/viewpointThetaPhi 90 0
/vis/ogl/set/printFilename view_top
/vis/ogl/printEPS

# Finalizar
/vis/viewer/flush