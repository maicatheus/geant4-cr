# vis_raytracer_final.mac - Macro final usando RayTracer

# Inicializar a simulação primeiro
/run/initialize

# Configurar visualização com RayTracer (disponível no seu servidor)
/vis/open RayTracer
/vis/drawVolume

# Definir extensão explícita para sua caixa de 10km
/vis/scene/add/extent -5 -5 -5 km 5 5 5 km

# Adicionar eixos de referência (em km)
/vis/scene/add/axes 0 0 0 1 km

# Configurar parâmetros do RayTracer para sua grande geometria
/vis/rayTracer/eyePosition 15 15 15 km  # Posição da câmera
/vis/rayTracer/target 0 0 0 km           # Ponto de foco
/vis/rayTracer/lightDirection -1 -1 -1   # Direção da luz
/vis/rayTracer/zoom 0.3                  # Zoom reduzido para caber toda a cena

# Gerar imagem 3D
/vis/rayTracer/trace geometry_3d_view.png

# Visualizações ortogonais
/vis/rayTracer/eyePosition 15 0 0 km
/vis/rayTracer/trace geometry_x_view.png

/vis/rayTector/eyePosition 0 15 0 km
/vis/rayTracer/trace geometry_y_view.png

/vis/rayTracer/eyePosition 0 0 15 km
/vis/rayTracer/trace geometry_z_view.png